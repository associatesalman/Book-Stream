# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (server-only). An HTTPS endpoint that accepts a JSON POST,
# e.g. an email service, CRM, Zapier/Make or Slack incoming webhook.
# While this is empty, the Contact form tells visitors their enquiry was NOT sent.
CONTACT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=
